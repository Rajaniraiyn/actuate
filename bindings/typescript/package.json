{
  "name": "actuate",
  "version": "0.1.0",
  "description": "Native UI automation for apps, windows, and desktops",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "scripts/install.mjs",
    "README.md"
  ],
  "scripts": {
    "build": "bun --bun tsc",
    "postinstall": "bun scripts/install.mjs",
    "install-native": "bun scripts/install.mjs",
    "test": "bun test",
    "typecheck": "bun --bun tsc -p tsconfig.test.json --noEmit"
  },
  "engines": {
    "bun": ">=1.4.0"
  },
  "packageManager": "bun@1.4.0",
  "devDependencies": {
    "typescript": "^5.9.3",
    "@types/bun": "^1.3.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Rajaniraiyn/actuate.git"
  },
  "license": "MIT OR Apache-2.0"
}

name unimation
bin unimation
version "0.1.0"
subcommand_required #true
flag "-p --provider" help="Automation provider; native selects the host, apple-simulator selects CoreSimulator." global=#true env=UNIMATION_PROVIDER default=native {
    arg <PROVIDER> {
        choices {
            choice native
            choice macos
            choice apple-simulator
            choice apple-device
        }
    }
}
flag --device help="Explicit provider device UDID; no implicit first-device selection." global=#true env=UNIMATION_DEVICE {
    arg <DEVICE>
}
flag --device-set help="Existing simulator device set, required for apple-simulator." global=#true env=UNIMATION_DEVICE_SET {
    arg <DEVICE_SET>
}
flag --format help="Output format. Text is plain and identical in terminals and pipes." global=#true default=text {
    arg <FORMAT> {
        choices {
            choice json
            choice compact
            choice text
        }
    }
}
flag --json help="Emit full JSON; sessions emit one JSON response per line." global=#true conflicts=--format
flag "-h --help" help="Print help" action=help builtin=#true
flag "-V --version" help="Print version" action=version builtin=#true
complete device_set type=dir
cmd completions help="Generate a shell completion script using the command specification." {
    flag "-h --help" help="Print help" action=help builtin=#true
    arg <SHELL> {
        choices {
            choice bash
            choice zsh
            choice fish
        }
    }
}
cmd apple help="Apple resource discovery; interaction uses the shared commands." subcommand_required=#true {
    flag "-h --help" help="Print help" action=help builtin=#true
    cmd devices help="Discover physical Apple devices through the available transport." subcommand_required=#true {
        flag "-h --help" help="Print help" action=help builtin=#true
        cmd list {
            flag "-h --help" help="Print help" action=help builtin=#true
        }
    }
    cmd simulators help="Inspect installed simulators without booting or installing anything." subcommand_required=#true {
        flag "-h --help" help="Print help" action=help builtin=#true
        cmd list help="List native runtime, device-type and device records." {
            flag "-h --help" help="Print help" action=help builtin=#true
        }
    }
}
cmd discover help="List running applications and accessibility permission state." {
    flag --scope default=all {
        arg <SCOPE> {
            choices {
                choice all
                choice apps
            }
        }
    }
    flag "-h --help" help="Print help" action=help builtin=#true
}
cmd observe help="Read the native accessibility tree for an application." {
    alias snapshot
    flag --max-nodes default="1000" {
        arg <MAX_NODES>
    }
    flag --max-depth default="30" {
        arg <MAX_DEPTH>
    }
    flag --interactive
    flag --hide-hidden
    flag --limit default="200" {
        arg <LIMIT>
    }
    flag --scope default=application {
        arg <SCOPE> {
            choices {
                choice application
                choice window
            }
        }
    }
    flag "-h --help" help="Print help" action=help builtin=#true
    arg "[PID]"
}
cmd view help="Render a saved native snapshot without changing its references." {
    flag --root {
        arg <ROOT>
    }
    flag --interactive
    flag --hide-hidden
    flag --limit default="200" {
        arg <LIMIT>
    }
    flag "-h --help" help="Print help" action=help builtin=#true
    arg <SNAPSHOT>
}
cmd capture help="Capture the main display or an explicitly selected display/window." {
    flag --display {
        arg <DISPLAY>
    }
    flag --window {
        arg <WINDOW>
    }
    flag --backend default=native {
        arg <BACKEND> {
            choices {
                choice native
                choice executable
            }
        }
    }
    flag --max-pixel-edge {
        arg <MAX_PIXEL_EDGE>
    }
    flag "-h --help" help="Print help" action=help builtin=#true
    arg <PATH>
}
cmd displays help="List native display geometry." {
    flag "-h --help" help="Print help" action=help builtin=#true
}
cmd windows help="List native window IDs, owners and geometry." {
    flag "-h --help" help="Print help" action=help builtin=#true
}
cmd capabilities help="Report delivery routes and availability." {
    flag "-h --help" help="Print help" action=help builtin=#true
}
cmd diff help="Compare two snapshots saved from the same live session." {
    flag --modified-only
    flag "-h --help" help="Print help" action=help builtin=#true
    arg <BEFORE>
    arg <AFTER>
}
cmd query help="Query a saved snapshot without discarding fields from matching nodes." {
    flag --role {
        arg <ROLE>
    }
    flag --name {
        arg <NAME>
    }
    flag --action {
        arg <ACTION>
    }
    flag "-h --help" help="Print help" action=help builtin=#true
    arg <SNAPSHOT>
}
cmd spec help="Export the portable Usage command specification." {
    flag "-h --help" help="Print help" action=help builtin=#true
}
cmd protocol help="Show JSON session commands and delivery semantics." {
    flag "-h --help" help="Print help" action=help builtin=#true
}
cmd session help="Read JSON requests from stdin, retaining references until EOF." {
    flag "-h --help" help="Print help" action=help builtin=#true
}
